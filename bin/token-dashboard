#!/usr/bin/env python3
"""token-dashboard: a small desktop window showing where your Claude Code tokens go.

Starts a read-only server on 127.0.0.1 (this machine only) and opens it in an app-style
window (Chrome / Chromium / Edge / Brave in --app mode) or your default browser.
Closing the window stops the server. Standard library only; nothing leaves your machine.

  token-dashboard              open the window
  token-dashboard --no-open    just serve, print the URL
  token-dashboard --browser    use your default browser tab instead of an app window
  token-dashboard --demo       sample data, no Claude Code history needed
  token-dashboard --port 8765
  token-dashboard --team DIR --name alice-laptop   include other devices (shared account)
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import threading
import time
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import token_data  # noqa: E402

HOME = Path.home()
CLAUDE = HOME / ".claude"
TEAM_DIR = None
DEMO = False


class Handler(BaseHTTPRequestHandler):
    server_version = "token-dashboard"

    def log_message(self, *a):          # quiet
        pass

    def _send(self, code, body, ctype):
        b = body if isinstance(body, bytes) else body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        # Reject foreign Host headers (DNS-rebinding protection); we only serve localhost.
        host = (self.headers.get("Host") or "").split(":")[0].lower()
        if host not in ("127.0.0.1", "localhost"):
            return self._send(421, "misdirected request", "text/plain")
        url = urlparse(self.path)
        path = url.path
        if path == "/":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if path == "/api/view":
            q = parse_qs(url.query)
            one = lambda k, d: (q.get(k) or [d])[0]
            try:
                v = token_data.view(token_data.demo_payload() if DEMO else token_data.payload(TEAM_DIR), one("range", "30"), one("project", "all")[:80], one("rank", "fresh"))
                return self._send(200, json.dumps(v), "application/json")
            except Exception as e:
                return self._send(500, json.dumps({"error": str(e)}), "application/json")
        if path == "/api/data":
            try:
                return self._send(200, json.dumps(token_data.payload(TEAM_DIR)), "application/json")
            except Exception as e:      # never crash the server on a bad transcript
                return self._send(500, json.dumps({"error": str(e)}), "application/json")
        self._send(404, "not found", "text/plain")


def find_app_browser():
    names = ["google-chrome", "google-chrome-stable", "chromium", "chromium-browser", "brave-browser",
             "microsoft-edge", "microsoft-edge-stable", "chrome", "msedge"]
    for n in names:
        p = shutil.which(n)
        if p:
            return p
    cands = []
    if sys.platform == "win32":
        for base in filter(None, (os.environ.get("ProgramFiles"), os.environ.get("ProgramFiles(x86)"), os.environ.get("LOCALAPPDATA"))):
            cands += [Path(base) / r"Microsoft\Edge\Application\msedge.exe",
                      Path(base) / r"Google\Chrome\Application\chrome.exe",
                      Path(base) / r"BraveSoftware\Brave-Browser\Application\brave.exe"]
    elif sys.platform == "darwin":
        cands += [Path("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"),
                  Path("/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"),
                  Path("/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"),
                  Path("/Applications/Chromium.app/Contents/MacOS/Chromium")]
    return next((str(p) for p in cands if p.exists()), None)


def main():
    ap = argparse.ArgumentParser(description="Desktop view of Claude Code token usage")
    ap.add_argument("--port", type=int, default=8765)
    ap.add_argument("--no-open", action="store_true")
    ap.add_argument("--browser", action="store_true", help="open a normal browser tab instead of an app window")
    ap.add_argument("--team", metavar="DIR", help="shared folder with other devices' exports (default: the one remembered by token-report --export)")
    ap.add_argument("--demo", action="store_true", help="show built-in sample data instead of your usage")
    ap.add_argument("--name", help="this device's name in the team view (default: hostname)")
    a = ap.parse_args()
    global TEAM_DIR, DEMO
    DEMO = a.demo
    TEAM_DIR = os.path.abspath(os.path.expanduser(a.team)) if a.team else None
    if a.name:
        os.environ["TOKEN_STACK_DEVICE"] = a.name

    srv = None
    for port in range(a.port, a.port + 20):
        try:
            srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
            break
        except OSError:
            continue
    if not srv:
        sys.exit(f"no free port near {a.port}")
    url = f"http://127.0.0.1:{srv.server_address[1]}/"
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    print(f"token-dashboard: {url}  (Ctrl+C to stop)")

    if not a.no_open:
        exe = None if a.browser else find_app_browser()
        if exe:
            profile = HOME / ".cache" / "token-dashboard" / "profile"
            profile.mkdir(parents=True, exist_ok=True)
            t0 = time.time()
            try:
                proc = subprocess.Popen([exe, f"--app={url}", f"--user-data-dir={profile}", "--no-first-run",
                                         "--no-default-browser-check", "--window-size=1120,900"],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                proc.wait()
                if time.time() - t0 > 3:      # the window really was ours and it was closed
                    return
            except OSError:
                webbrowser.open(url)
        else:
            webbrowser.open(url)
    try:
        while True:
            time.sleep(3600)
    except KeyboardInterrupt:
        pass


