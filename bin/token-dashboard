PAGE = (_PAGE.replace("/*THEME_CSS*/", token_data.theme_css())
        .replace("__THEMES__", json.dumps({k: {"label": v["label"], "dark": v["dark"]} for k, v in token_data.THEMES.items()})))

if __name__ == "__main__":
    main()
