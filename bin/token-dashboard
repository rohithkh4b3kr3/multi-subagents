<script>
"use strict";
const $ = (s, r) => (r || document).querySelector(s);
const THEMES = __THEMES__;
const RANGES = [["today", "Today"], ["7", "7 days"], ["30", "30 days"], ["all", "All"]];
const TABS = [["overview", "Overview"], ["stack", "Stack"], ["team", "Team"], ["sessions", "Sessions"]];
const CHART = [["cr", "Re-read"], ["cw", "New context"], ["out", "Output"], ["req", "Requests"]];
const CHART_NAME = { cr: "History re-read", cw: "New context written", out: "Output", req: "Requests" };
const RANK = [["fresh", "New + output"], ["cr", "Re-read"], ["req", "Requests"]];
const ST = { range: "30", project: "all", metric: "cr", rank: "fresh", table: false, theme: document.documentElement.getAttribute("data-theme") };
try { const s = JSON.parse(localStorage.getItem("token-dashboard") || "{}"); for (const k of ["range", "project", "metric", "rank"]) if (s[k]) ST[k] = s[k]; } catch (e) {}
const save = () => { try { localStorage.setItem("token-dashboard", JSON.stringify({ range: ST.range, project: ST.project, metric: ST.metric, rank: ST.rank, theme: ST.theme })); } catch (e) {} };
let V = null, tab = "overview";

function h(tag, attrs, ...kids) {                 // DOM builder: text always goes through textContent
  const el = document.createElement(tag);
  for (const k in (attrs || {})) { if (k === "class") el.className = attrs[k]; else el.setAttribute(k, attrs[k]); }
  for (const c of kids) if (c != null && c !== false) el.append(c.nodeType ? c : document.createTextNode(String(c)));
  return el;
}
const NS = "http://www.w3.org/2000/svg";
const s = (tag, attrs) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); return e; };
const comma = n => Math.round(n).toLocaleString("en-US");
function compact(n) {
  const f = (v, u) => { const x = v >= 100 ? v.toFixed(0) : v >= 10 ? v.toFixed(1) : v.toFixed(2); return (x.includes(".") ? x.replace(/0+$/, "").replace(/\.$/, "") : x) + u; };
  if (n >= 999.5e6) return f(n / 1e9, "B");
  if (n >= 999.5e3) return f(n / 1e6, "M");
  if (n >= 1e3) return f(n / 1e3, "K");
  return String(Math.round(n));
}
function ago(hours) {
  if (hours == null || !isFinite(hours)) return "unknown";
  return hours < 1 ? Math.max(1, Math.round(hours * 60)) + " min ago" : hours < 48 ? Math.round(hours) + " h ago" : Math.round(hours / 24) + " d ago";
}
const VERDICT = { used: ["good", "✓", "Used"], active: ["good", "✓", "Active"], installed: ["na", "–", "Installed"], unused: ["warn", "!", "Installed, not used"],
                  hookoff: ["warn", "!", "Installed, hooks off"], missing: ["bad", "✕", "Not installed"] };
const pill = (kind, icon, label) => h("span", { class: "pill " + kind }, h("i", { "aria-hidden": "true" }, icon), label);
const card = (title, hint, ...body) => h("div", { class: "card" }, h("h2", null, title), hint ? h("p", { class: "hint" }, hint) : null, ...body);

/* ---------- chrome ---------- */
function buildChrome() {
  const tabs = $("#tabs"); tabs.replaceChildren();
  for (const [k, label] of TABS) { const a = h("a", { href: "#" + k }, label); if (k === tab) a.setAttribute("aria-current", "page"); tabs.append(a); }
  const r = $("#range"); r.replaceChildren();
  for (const [k, label] of RANGES) {
    const i = RANGES.findIndex(x => x[0] === k) + 1;
    const b = h("button", { "aria-pressed": String(ST.range === k), title: "Key " + i }, label);
    b.onclick = () => setFilter("range", k);
    r.append(b);
  }
  const t = $("#theme");
  if (!t.options.length) for (const k in THEMES) t.append(h("option", { value: k }, THEMES[k].label));
  t.value = ST.theme;
  for (const [k] of TABS) $("#v-" + k).hidden = k !== tab;
}
function buildProjects() {
  const sel = $("#project"); sel.replaceChildren(h("option", { value: "all" }, "All projects"));
  for (const p of V.projects) sel.append(h("option", { value: p }, p));
  if (ST.project !== "all" && !V.projects.includes(ST.project)) ST.project = "all";
  sel.value = ST.project;
}
function setFilter(k, v) { ST[k] = v; save(); load(true); }
function setTheme(name) { ST.theme = name; document.documentElement.setAttribute("data-theme", name); $("#theme").value = name; save(); if (V) renderChart(); }
function route() { const t = (location.hash || "#overview").slice(1); tab = TABS.some(x => x[0] === t) ? t : "overview"; buildChrome(); if (tab === "overview" && V) renderChart(); }

/* ---------- overview ---------- */
function spark(days, key) {
  const vals = days.slice(-30).map(d => d[key]), mx = Math.max(...vals, 1), n = vals.length || 1;
  const svg = s("svg", { viewBox: "0 0 100 20", preserveAspectRatio: "none", "aria-hidden": "true" });
  vals.forEach((v, i) => { const hh = v ? Math.max(1.5, v / mx * 19) : 0; svg.append(s("rect", { x: i * 100 / n, y: 20 - hh, width: Math.max(0.6, 100 / n - 0.8), height: hh })); });
  return svg;
}
function renderOverview() {
  const T = V.totals, rtk = V.rtk || {}, el = $("#v-overview"); el.replaceChildren();
  const hero = h("div", { class: "hero" }, h("div", { class: "num" }, T.reread_pct == null ? "–" : T.reread_pct + "%"),
    h("div", { class: "cap" }, T.reread_pct == null ? "No usage in this range." : h("span", null, "of the input tokens in this range were the conversation being ", h("b", null, "re-read from cache"),
      ". Each request re-sends the whole history, so shorter sessions (", h("code", null, "/clear"), " between tasks) save more than any single tool.")));
  const tiles = [["Requests", comma(T.req), "model calls", "req"], ["New context", compact(T.cw), "written to cache", "cw"], ["Re-read", compact(T.cr), "tokens from cache", "cr"],
                 ["Output", compact(T.out), "tokens Claude wrote", "out"], ["Tool output", "~" + compact(T.tool_tokens), "estimated tokens", null],
                 ["rtk saved", rtk.total_saved != null ? compact(rtk.total_saved) : "–", comma(rtk.total_commands || 0) + " commands, all time", null]];
  const tl = h("div", { class: "tiles" });
  for (const [l, v, n, key] of tiles) tl.append(h("div", { class: "tile" }, h("div", { class: "l" }, l), h("div", { class: "v", title: key ? "" : "" }, v), key ? spark(V.days, key) : null, h("div", { class: "n" }, n)));
  const c1 = card("Where your tokens go", V.range_label + " · " + (V.project === "all" ? "all projects" : V.project), hero, tl);
  const chartCard = h("div", { class: "card" });
  chartCard.append(h("div", { class: "headrow" }, h("div", null, h("h2", { id: "chartTitle" }, ""), h("p", { class: "hint", id: "chartHint" }, "")),
    h("div", { class: "seg", id: "metricSeg", role: "group", "aria-label": "Metric" }), h("button", { class: "btn", id: "tview", "aria-pressed": "false" }, "Table")), h("div", { class: "chartbox", id: "chartbox" }));
  const bars = (rows, fmt, empty) => {
    const list = h("div", { class: "list" });
    if (!rows.length) { list.append(h("div", { class: "empty" }, empty)); return list; }
    const mx = Math.max(...rows.map(r => r[1])) || 1;
    for (const [name, v, tip] of rows) list.append(h("div", { class: "r", title: tip || "" }, h("div", { class: "name" }, name), h("div", { class: "track" }, h("div", { class: "fill", style: "width:" + Math.max(0.5, v / mx * 100) + "%" })), h("div", { class: "val" }, fmt(v))));
    return list;
  };
  const tools = V.tools.map(t => [t.name === "?" ? "(unknown)" : t.name.replace(/^mcp__/, "mcp: ").replace(/__/g, " › "), t.tokens, comma(t.calls) + " calls"]);
  const cmds = V.commands.map(c => [c.name, c.n]);
  el.append(c1, chartCard, h("div", { class: "grid2" },
    card("Tool output, by tool", "Estimated tokens the tools sent back into the conversation.", bars(tools, v => "~" + compact(v), "No tool calls in this range.")),
    card("Shell commands", "How often each command ran (names only, never arguments).", bars(cmds, v => comma(v) + "×", "No shell commands in this range."))));
  $("#tview").onclick = () => { ST.table = !ST.table; renderChart(); };
  renderChart();
}
function niceScale(v) {
  if (v <= 0) return { max: 1, steps: 4 };
  const p = Math.pow(10, Math.floor(Math.log10(v))), f = v / p, n = f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10;
  return { max: n * p, steps: n === 2 ? 4 : 5 };
}
function renderChart() {
  const box = $("#chartbox"); if (!box || !V) return;
  const m = ST.metric;
  const seg = $("#metricSeg"); seg.replaceChildren();
  for (const [k, label] of CHART) { const b = h("button", { "aria-pressed": String(m === k) }, label); b.onclick = () => { ST.metric = k; save(); renderChart(); }; seg.append(b); }
  $("#chartTitle").textContent = CHART_NAME[m] + ", per day";
  $("#chartHint").textContent = { cr: "Tokens re-read from cache: the large number. It grows with every long conversation.", cw: "Tokens newly written into context: prompts, tool output and Claude's replies.",
    out: "Tokens Claude generated.", req: "Model calls made." }[m];
  $("#tview").setAttribute("aria-pressed", String(ST.table));
  box.replaceChildren();
  const days = V.days;
  if (!days.length) { box.append(h("div", { class: "empty" }, "No data in this range.")); return; }
  if (ST.table) {
    const t = h("table", null, h("thead", null, h("tr", null, h("th", null, "Date"), ...["Requests", "Re-read", "New context", "Output"].map(x => h("th", { class: "num" }, x)))), h("tbody"));
    for (const d of [...days].reverse()) t.tBodies[0].append(h("tr", null, h("td", null, d.d), ...[d.req, d.cr, d.cw, d.out].map(n => h("td", { class: "num" }, comma(n)))));
    box.append(h("div", { class: "tbl", style: "max-height:340px;overflow-y:auto" }, t)); return;
  }
  const W = Math.max(320, box.clientWidth || 800), H = 250, mg = { l: 50, r: 8, t: 10, b: 26 };
  const pw = W - mg.l - mg.r, ph = H - mg.t - mg.b, N = days.length, band = pw / N, bw = Math.max(1, Math.min(24, band - 2));
  const val = d => d[m], sc = niceScale(Math.max(...days.map(val)));
  const svg = s("svg", { class: "chart", viewBox: `0 0 ${W} ${H}`, width: W, height: H, role: "img", "aria-label": `${CHART_NAME[m]} per day, ${days[0].d} to ${days[N - 1].d}. Use the Table button for exact values.` });
  const y = v => mg.t + ph - (v / sc.max) * ph;
  for (let i = 0; i <= sc.steps; i++) {
    const v = sc.max * i / sc.steps, yy = y(v);
    svg.append(s("line", { x1: mg.l, x2: W - mg.r, y1: yy, y2: yy, stroke: "var(--border)", "stroke-width": 1, opacity: i === 0 ? 1 : 0.6 }));
    const t = s("text", { x: mg.l - 8, y: yy + 4, "text-anchor": "end" }); t.textContent = compact(v); svg.append(t);
  }
  const every = Math.max(1, Math.ceil(N / Math.max(2, Math.floor(pw / 70))));
  const tip = h("div", { class: "tip" });
  const showTip = (d, i) => {
    tip.replaceChildren(h("div", { class: "d" }, d.d), h("div", { class: "big" }, comma(val(d)), " ", h("span", { class: "d", style: "font-size:12px;font-weight:400" }, CHART_NAME[m].toLowerCase())),
      ...CHART.filter(([k]) => k !== m).map(([k]) => h("div", { class: "r" }, h("span", null, CHART_NAME[k]), h("span", null, comma(d[k])))));
    tip.style.display = "block";
    const cx = mg.l + band * i + band / 2, w = tip.offsetWidth;
    tip.style.left = Math.max(0, Math.min(W - w, cx - w / 2)) + "px";
    tip.style.top = Math.max(0, y(val(d)) - tip.offsetHeight - 10) + "px";
  };
  days.forEach((d, i) => {
    const v = val(d), x0 = mg.l + band * i + (band - bw) / 2;
    const hit = s("rect", { class: "hit", x: mg.l + band * i, y: mg.t, width: band, height: ph, tabindex: 0, "aria-label": `${d.d}: ${comma(v)}` });
    hit.addEventListener("pointermove", () => showTip(d, i)); hit.addEventListener("focus", () => showTip(d, i));
    hit.addEventListener("pointerleave", () => { tip.style.display = "none"; }); hit.addEventListener("blur", () => { tip.style.display = "none"; });
    svg.append(hit);
    const hgt = (v / sc.max) * ph;
    if (hgt > 0) {
      const r = Math.min(4, bw / 2, hgt), y1 = y(v), y0 = mg.t + ph;
      svg.append(s("path", { class: "col" + (i === N - 1 ? " last" : ""), "pointer-events": "none",
        d: `M${x0},${y0} V${y1 + r} Q${x0},${y1} ${x0 + r},${y1} H${x0 + bw - r} Q${x0 + bw},${y1} ${x0 + bw},${y1 + r} V${y0} Z` }));
    }
    if ((N - 1 - i) % every === 0) { const t = s("text", { x: mg.l + band * i + band / 2, y: H - 8, "text-anchor": "middle" }); t.textContent = d.d.slice(5); svg.append(t); }
  });
  box.append(svg, tip);
}

/* ---------- stack ---------- */
function renderStack() {
  const t = h("table", null, h("thead", null, h("tr", null, h("th", null, "Component"), h("th", null, "Job"), h("th", null, "Status"), h("th", { class: "num" }, "Calls"), h("th", null, "Note"))), h("tbody"));
  for (const r of V.stack) {
    const [kind, icon, label] = VERDICT[r.verdict] || ["na", "–", r.verdict];
    t.tBodies[0].append(h("tr", null, h("td", null, r.name), h("td", { class: "dim" }, r.job), h("td", null, pill(kind, icon, label)),
      h("td", { class: "num" }, r.calls == null ? "–" : comma(r.calls)), h("td", { class: "note" }, r.note || "")));
  }
  $("#v-stack").replaceChildren(card("Is the stack actually used?", "Installed is not the same as working. “Not used” means no calls in the selected range; try a fresh session. token-history is “Active” when its hooks are on, and its calls column counts injections.",
    h("div", { class: "tbl" }, t)));
}

/* ---------- team ---------- */
function renderTeam() {
  const T = V.team, rows = T.rows;
  const seg = h("div", { class: "seg", role: "group", "aria-label": "Rank devices by" });
  for (const [k, label] of RANK) { const b = h("button", { "aria-pressed": String(ST.rank === k) }, label); b.onclick = () => setFilter("rank", k); seg.append(b); }
  const t = h("table", null, h("thead", null, h("tr", null, h("th", null, "Device"), h("th", null, "Last update"), ...["Requests", "New context", "Output", "Re-read"].map(x => h("th", { class: "num" }, x)), h("th", null, "Share"))), h("tbody"));
  const sum = k => rows.reduce((a, r) => a + r[k], 0);
  for (const r of rows) {
    const upd = r.local ? pill("good", "✓", "live") : r.stale ? pill("warn", "!", ago(r.age_hours) + " (stale)") : h("span", null, ago(r.age_hours));
    t.tBodies[0].append(h("tr", null, h("td", null, r.device, r.local ? h("span", { class: "dim" }, " (this device)") : null), h("td", null, upd),
      ...[r.req, r.cw, r.out, r.cr].map(n => h("td", { class: "num" }, comma(n))),
      h("td", null, h("div", { class: "share" }, h("div", { class: "t" }, h("div", { class: "f", style: "width:" + (r.share * 100).toFixed(1) + "%" })), h("div", { class: "p" }, Math.round(r.share * 100) + "%")))));
  }
  t.tBodies[0].append(h("tr", { class: "total" }, h("td", null, "Total"), h("td"), ...[sum("req"), sum("cw"), sum("out"), sum("cr")].map(n => h("td", { class: "num" }, comma(n))), h("td")));
  const setup = T.dir ? h("p", { class: "hint" }, "Devices that share ", h("code", null, T.dir), ". This device is live; the others update whenever they export.")
    : h("div", null, h("p", { class: "hint" }, "Only this device is shown. To add the other people or machines on your account, run this on each device, then reopen this window:"),
        h("pre", { class: "code" }, "token-report --export <shared folder> --name <who>"));
  $("#v-team").replaceChildren(card("Who is using how much", "Per-device usage for the selected range, ranked by " + RANK.find(x => x[0] === T.rank)[1].toLowerCase() + ".",
    h("div", { style: "margin-bottom:10px" }, seg), h("div", { class: "tbl" }, t), setup));
}

/* ---------- sessions ---------- */
function renderSessions() {
  const t = h("table", null, h("thead", null, h("tr", null, h("th", null, "Ended"), h("th", null, "Project"), ...["Requests", "Avg context", "Re-read", "New context", "Output"].map(x => h("th", { class: "num" }, x)), h("th", null, "Note"))), h("tbody"));
  for (const r of V.sessions) t.tBodies[0].append(h("tr", null, h("td", null, r.end), h("td", null, r.project + (r.sub ? " (subagent)" : "")),
    ...[comma(r.req), compact(r.avg), compact(r.cr), compact(r.cw), compact(r.out)].map(x => h("td", { class: "num" }, x)), h("td", null, r.large ? pill("warn", "!", "Large: /handoff + /clear") : "")));
  $("#v-sessions").replaceChildren(card("Biggest sessions", "Every request re-sends the whole conversation. “Avg context” is roughly what each request in that session re-read; large sessions (100K+) are the ones worth handing off and clearing.",
    V.sessions.length ? h("div", { class: "tbl" }, t) : h("div", { class: "empty" }, "No sessions in this range.")));
}

/* ---------- data ---------- */
async function load(manual) {
  const main = $("#main");
  if (manual) main.classList.add("loading");
  try {
    const q = new URLSearchParams({ range: ST.range, project: ST.project, rank: ST.rank });
    const res = await fetch("/api/view?" + q, { cache: "no-store" });
    const d = await res.json();
    if (d.error) throw new Error(d.error);
    V = d;
    $("#error").replaceChildren();
    $("#device").textContent = V.device;
    $("#updated").textContent = "updated " + new Date().toLocaleTimeString();
    buildChrome(); buildProjects();
    renderOverview(); renderStack(); renderTeam(); renderSessions();
  } catch (e) {
    $("#error").replaceChildren(h("div", { class: "banner" }, "Could not load data: " + e.message));
    $("#updated").textContent = "offline";
  } finally { main.classList.remove("loading"); }
}

/* ---------- events ---------- */
$("#refresh").onclick = () => load(true);
$("#project").onchange = e => setFilter("project", e.target.value);
$("#theme").onchange = e => setTheme(e.target.value);
$("#helpbtn").onclick = () => { $("#help").hidden = !$("#help").hidden; };
$("#help").onclick = e => { if (e.target.id === "help") $("#help").hidden = true; };
window.addEventListener("hashchange", route);
window.addEventListener("keydown", e => {
  if (e.metaKey || e.ctrlKey || e.altKey || /^(INPUT|SELECT|TEXTAREA)$/.test((e.target || {}).tagName || "")) return;
  const k = e.key;
  if (k === "Escape") { $("#help").hidden = true; return; }
  if (k === "?") { $("#help").hidden = !$("#help").hidden; return; }
  if (k >= "1" && k <= "4") { setFilter("range", RANGES[+k - 1][0]); return; }
  if (k === "r") { load(true); return; }
  if (k === "t") { const names = Object.keys(THEMES); setTheme(names[(names.indexOf(ST.theme) + 1) % names.length]); return; }
  if (k === "ArrowRight" || k === "ArrowLeft") { const i = TABS.findIndex(x => x[0] === tab), n = TABS[(i + (k === "ArrowRight" ? 1 : TABS.length - 1)) % TABS.length][0]; location.hash = "#" + n; }
});
let rz; window.addEventListener("resize", () => { clearTimeout(rz); rz = setTimeout(() => { if (V && tab === "overview") renderChart(); }, 120); });
setInterval(() => { if (!document.hidden) load(false); }, 15000);
route(); load(false);
</script>
</body>
</html>
