<script>
"use strict";
const $ = s => document.querySelector(s);
const ST = { range: "30", project: "all", metric: "cr", tmetric: "fresh", table: false, theme: "auto" };
try { Object.assign(ST, JSON.parse(localStorage.getItem("token-dashboard") || "{}")); } catch (e) {}
{ const q = new URLSearchParams(location.search).get("theme"); if (["auto", "light", "dark"].includes(q)) ST.theme = q; }
const save = () => { try { localStorage.setItem("token-dashboard", JSON.stringify(ST)); } catch (e) {} };
let DATA = null;

const RANGES = [["today", "Today"], ["7", "7 days"], ["30", "30 days"], ["all", "All"]];
const METRICS = [["cr", "Re-read"], ["cw", "New context"], ["out", "Output"]];
const METRIC_NAME = { cr: "History re-read", cw: "New context written", out: "Output", req: "Requests" };

function h(tag, attrs, ...kids) {            // DOM builder: text always via textContent
  const el = document.createElement(tag);
  for (const k in (attrs || {})) { if (k === "class") el.className = attrs[k]; else el.setAttribute(k, attrs[k]); }
  for (const c of kids) if (c != null) el.append(c.nodeType ? c : document.createTextNode(String(c)));
  return el;
}
const pad = n => String(n).padStart(2, "0");
const iso = d => d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
const daysAgo = n => { const d = new Date(); d.setDate(d.getDate() - n); return iso(d); };
const comma = n => Math.round(n).toLocaleString("en-US");
function compact(n) {
  const f = (v, u) => {
    const x = v >= 100 ? v.toFixed(0) : v >= 10 ? v.toFixed(1) : v.toFixed(2);
    return (x.includes(".") ? x.replace(/0+$/, "").replace(/\.$/, "") : x) + u;   // trim zeros only after a decimal point
  };
  if (n >= 999.5e6) return f(n / 1e9, "B");
  if (n >= 999.5e3) return f(n / 1e6, "M");
  if (n >= 1e3) return f(n / 1e3, "K");
  return String(Math.round(n));
}

function rangeStart() {
  if (ST.range === "all") return null;
  if (ST.range === "today") return daysAgo(0);
  return daysAgo(parseInt(ST.range, 10) - 1);
}

function slice() {
  const start = rangeStart();
  const bs = DATA.buckets.filter(b => (!start || b.d >= start) && (ST.project === "all" || b.p === ST.project));
  const A = { req: 0, in: 0, cw: 0, cr: 0, out: 0, tool: {}, bash: {}, mcp: {}, agent: {}, skill: {}, day: {} };
  for (const b of bs) {
    for (const k of ["req", "in", "cw", "cr", "out"]) A[k] += b[k];
    for (const n in b.tool) { const e = (A.tool[n] = A.tool[n] || [0, 0]); e[0] += b.tool[n][0]; e[1] += b.tool[n][1]; }
    for (const g of ["bash", "mcp", "agent", "skill"]) for (const n in b[g]) A[g][n] = (A[g][n] || 0) + b[g][n];
    const d = (A.day[b.d] = A.day[b.d] || { req: 0, cw: 0, cr: 0, out: 0 });
    d.req += b.req; d.cw += b.cw; d.cr += b.cr; d.out += b.out;
  }
  A.start = start;
  return A;
}

/* ---------- filters ---------- */
function buildFilters() {
  const r = $("#range"); r.replaceChildren();
  for (const [k, label] of RANGES) {
    const b = h("button", { "aria-pressed": String(ST.range === k) }, label);
    b.onclick = () => { ST.range = k; save(); render(); };
    r.append(b);
  }
  const m = $("#metric"); m.replaceChildren();
  for (const [k, label] of METRICS) {
    const b = h("button", { "aria-pressed": String(ST.metric === k) }, label);
    b.onclick = () => { ST.metric = k; save(); render(); };
    m.append(b);
  }
  const sel = $("#project"); sel.replaceChildren(h("option", { value: "all" }, "All projects"));
  const projs = [...new Set(DATA.buckets.map(b => b.p))].sort();
  if (ST.project !== "all" && !projs.includes(ST.project)) ST.project = "all";
  for (const p of projs) sel.append(h("option", { value: p }, p));
  sel.value = ST.project;
}

/* ---------- hero + tiles ---------- */
function renderTop(A) {
  const input = A.cr + A.cw + A["in"];
  $("#heroNum").textContent = input ? Math.round(A.cr / input * 100) + "%" : "–";
  $("#heroCap").textContent = input
    ? "of the input tokens in this range were the conversation being re-read from cache. Each request re-sends the whole history, so shorter sessions (/clear between tasks) save more than any single tool."
    : "No usage in this range.";
  const toolTok = Object.values(A.tool).reduce((s, v) => s + v[1], 0) / 4;
  const rtk = DATA.rtk || {};
  const tiles = [
    ["Requests", comma(A.req), "model calls"],
    ["New context", compact(A.cw), "tokens written to cache"],
    ["History re-read", compact(A.cr), "tokens from cache"],
    ["Output", compact(A.out), "tokens Claude wrote"],
    ["Tool output", "~" + compact(toolTok), "estimated tokens"],
    ["rtk saved", rtk.total_saved != null ? compact(rtk.total_saved) : "–", rtk.total_commands ? comma(rtk.total_commands) + " commands, all time" : "shell output, all time"],
  ];
  const box = $("#tiles"); box.replaceChildren();
  for (const [l, v, n] of tiles) box.append(h("div", { class: "tile" }, h("div", { class: "l" }, l), h("div", { class: "v" }, v), h("div", { class: "n" }, n)));
}

/* ---------- daily chart ---------- */
function dateList(A) {
  const days = Object.keys(A.day).sort();
  if (!days.length) return [];
  const from = A.start && A.start < days[0] ? A.start : days[0];
  const out = [];
  const d = new Date(from + "T00:00:00"), end = new Date(iso(new Date()) + "T00:00:00");
  while (d <= end && out.length < 800) { out.push(iso(d)); d.setDate(d.getDate() + 1); }
  return out;
}
function niceScale(v) {
  if (v <= 0) return { max: 1, steps: 4 };
  const p = Math.pow(10, Math.floor(Math.log10(v))), f = v / p;
  const n = f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10;
  return { max: n * p, steps: n === 2 ? 4 : 5 };
}
function renderChart(A) {
  const box = $("#chartbox"); box.replaceChildren();
  $("#chartTitle").textContent = METRIC_NAME[ST.metric] + ", per day";
  $("#chartHint").textContent = ST.metric === "cr" ? "Tokens re-read from cache. This is the large number; it grows with every long conversation."
    : ST.metric === "cw" ? "Tokens newly written into context: your prompts, tool output and Claude's replies."
    : "Tokens Claude generated.";
  $("#tview").setAttribute("aria-pressed", String(ST.table));
  const days = dateList(A);
  if (!days.length) { box.append(h("div", { class: "empty" }, "No data in this range.")); return; }
  const val = d => (A.day[d] || {})[ST.metric] || 0;

  if (ST.table) {
    const t = h("table", null, h("thead", null, h("tr", null, h("th", null, "Date"), ...["Requests", "Re-read", "New context", "Output"].map(x => h("th", { class: "num" }, x)))), h("tbody"));
    for (const d of [...days].reverse()) {
      const x = A.day[d] || { req: 0, cr: 0, cw: 0, out: 0 };
      t.tBodies[0].append(h("tr", null, h("td", null, d), ...[x.req, x.cr, x.cw, x.out].map(n => h("td", { class: "num" }, comma(n)))));
    }
    box.append(h("div", { class: "wrap", style: "max-height:320px;overflow-y:auto" }, t));
    return;
  }

  const W = Math.max(320, box.clientWidth || 700), H = 240, m = { l: 48, r: 8, t: 10, b: 26 };
  const pw = W - m.l - m.r, ph = H - m.t - m.b, N = days.length, band = pw / N;
  const bw = Math.max(1, Math.min(24, band - 2));
  const sc = niceScale(Math.max(...days.map(val)));
  const NS = "http://www.w3.org/2000/svg";
  const s = (tag, attrs) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); return e; };
  const svg = s("svg", { viewBox: `0 0 ${W} ${H}`, width: W, height: H, role: "img",
    "aria-label": `${METRIC_NAME[ST.metric]} per day, ${days[0]} to ${days[N - 1]}. Use the Table button for exact values.` });
  const y = v => m.t + ph - (v / sc.max) * ph;
  for (let i = 0; i <= sc.steps; i++) {
    const v = sc.max * i / sc.steps, yy = y(v);
    svg.append(s("line", { x1: m.l, x2: W - m.r, y1: yy, y2: yy, stroke: "var(--grid)", "stroke-width": 1 }));
    const t = s("text", { x: m.l - 6, y: yy + 4, "text-anchor": "end" }); t.textContent = compact(v); svg.append(t);
  }
  const every = Math.max(1, Math.ceil(N / Math.max(2, Math.floor(pw / 64))));
  const tip = h("div", { class: "tip" });
  const showTip = (d, i) => {
    const x = A.day[d] || { req: 0, cr: 0, cw: 0, out: 0 };
    tip.replaceChildren(
      h("div", { class: "d" }, d),
      h("div", { class: "big" }, comma(val(d)), " ", h("span", { class: "d", style: "font-size:12px;font-weight:400" }, METRIC_NAME[ST.metric].toLowerCase())),
      h("div", { class: "r" }, h("span", null, "Requests"), h("span", null, comma(x.req))),
      ...METRICS.filter(([k]) => k !== ST.metric).map(([k]) => h("div", { class: "r" }, h("span", null, METRIC_NAME[k]), h("span", null, comma(x[k])))));
    tip.style.display = "block";
    const cx = m.l + band * i + band / 2, w = tip.offsetWidth;
    tip.style.left = Math.max(0, Math.min(W - w, cx - w / 2)) + "px";
    tip.style.top = Math.max(0, y(val(d)) - tip.offsetHeight - 10) + "px";
  };
  days.forEach((d, i) => {
    const v = val(d), x0 = m.l + band * i + (band - bw) / 2;
    const hit = s("rect", { class: "hit", x: m.l + band * i, y: m.t, width: band, height: ph, tabindex: 0, "aria-label": `${d}: ${comma(v)}` });
    hit.addEventListener("pointermove", () => showTip(d, i));
    hit.addEventListener("focus", () => showTip(d, i));
    hit.addEventListener("pointerleave", () => { tip.style.display = "none"; });
    hit.addEventListener("blur", () => { tip.style.display = "none"; });
    svg.append(hit);
    const hgt = (v / sc.max) * ph;
    if (hgt > 0) {
      const r = Math.min(4, bw / 2, hgt), y1 = y(v), y0 = m.t + ph;
      svg.append(s("path", { class: "bar-col", "pointer-events": "none",
        d: `M${x0},${y0} V${y1 + r} Q${x0},${y1} ${x0 + r},${y1} H${x0 + bw - r} Q${x0 + bw},${y1} ${x0 + bw},${y1 + r} V${y0} Z` }));
    }
    if ((N - 1 - i) % every === 0) {
      const t = s("text", { x: m.l + band * i + band / 2, y: H - 8, "text-anchor": "middle" }); t.textContent = d.slice(5); svg.append(t);
    }
  });
  svg.append(s("line", { x1: m.l, x2: W - m.r, y1: m.t + ph, y2: m.t + ph, stroke: "var(--grid)", "stroke-width": 1 }));
  box.append(svg, tip);
}

/* ---------- bar lists ---------- */
function barList(el, entries, fmt, empty) {
  el.replaceChildren();
  if (!entries.length) { el.append(h("div", { class: "empty" }, empty)); return; }
  const max = Math.max(...entries.map(e => e[1]));
  for (const [name, v, extra] of entries) {
    el.append(h("div", { class: "row", title: extra || "" },
      h("div", { class: "name" }, name),
      h("div", { class: "track" }, h("div", { class: "bar", style: `width:${Math.max(0.5, v / max * 100)}%` })),
      h("div", { class: "val" }, fmt(v))));
  }
}
function renderBars(A) {
  const tools = Object.entries(A.tool).map(([n, [c, ch]]) => [n === "?" ? "(unknown)" : n.replace(/^mcp__/, "mcp: ").replace(/__/g, " › "), ch / 4, comma(c) + " calls"])
    .sort((a, b) => b[1] - a[1]).slice(0, 8);
  barList($("#toolBars"), tools, v => "~" + compact(v), "No tool calls in this range.");
  const cmds = Object.entries(A.bash).sort((a, b) => b[1] - a[1]).slice(0, 8);
  barList($("#cmdBars"), cmds, v => comma(v) + "×", "No shell commands in this range.");
}

/* ---------- usage / status ---------- */
function statusCell(kind, label) {
  const sym = { good: "✓", warn: "!", bad: "✕", na: "–" }[kind];
  return h("span", { class: "st" }, h("span", { class: "ic " + kind, "aria-hidden": "true" }, sym), label);
}
function renderUsage(A) {
  const S = DATA.status, rtk = DATA.rtk || {};
  const has = (list, key) => list.some(x => x.includes(key));
  const calls = (obj, key) => Object.entries(obj).filter(([n]) => n.includes(key)).reduce((s, [, v]) => s + v, 0);
  const rows = [];
  const add = (name, job, installed, callCount, note) => rows.push({ name, job, installed, callCount, note });
  add("rtk", "compresses shell output", S.rtk_installed, S.rtk_hook ? (rtk.total_commands || 0) : 0, S.rtk_hook ? "all time" : "hook missing: run rtk init -g");
  add("code-review-graph", "callers, blast radius (MCP)", has(S.mcp, "code-review-graph"), calls(A.mcp, "code-review-graph"));
  add("token-savior", "symbol-level reads (MCP)", has(S.mcp, "token-savior"), calls(A.mcp, "token-savior"));
  add("context-mode", "big-output sandbox (plugin)", has(S.plugins, "context-mode"), calls(A.mcp, "context-mode"));
  add("graphify", "project/docs map (skill)", S.graphify, calls(A.skill, "graphify"));
  add("caveman", "terse replies (plugin)", has(S.plugins, "caveman"), null, "active via session hooks");
  for (const a of ["lean-main", "lean-explorer", "lean-reviewer", "lean-coder"]) {
    if (a === "lean-main") add(a, "default agent", S.agents.includes(a), null, S.default_agent === a ? "set as default" : "installed, not the default");
    else add(a, "subagent", S.agents.includes(a), calls(A.agent, a));
  }
  const t = h("table", null, h("thead", null, h("tr", null, h("th", null, "Component"), h("th", null, "Job"), h("th", null, "Status"), h("th", { class: "num" }, "Calls"), h("th", null, "Note"))), h("tbody"));
  for (const r of rows) {
    let st;
    if (!r.installed) st = statusCell("bad", "Not installed");
    else if (r.callCount == null) st = statusCell(r.name === "lean-main" && DATA.status.default_agent !== "lean-main" ? "na" : "good", "Installed");
    else if (r.callCount > 0) st = statusCell("good", "Used");
    else st = statusCell("warn", "Installed, not used");
    t.tBodies[0].append(h("tr", null, h("td", null, r.name), h("td", null, r.job), h("td", null, st),
      h("td", { class: "num" }, r.callCount == null ? "–" : comma(r.callCount)), h("td", null, r.note || "")));
  }
  $("#usage").replaceChildren(t);
}

/* ---------- team / devices ---------- */
const TMETRICS = [["fresh", "New + output"], ["cr", "Re-read"], ["req", "Requests"]];
function ago(iso) {
  const t = new Date(iso).getTime();
  if (!iso || isNaN(t)) return { text: "unknown", hours: Infinity };
  const h = (Date.now() - t) / 3600000;
  return { text: h < 1 ? Math.max(1, Math.round(h * 60)) + " min ago" : h < 48 ? Math.round(h) + " h ago" : Math.round(h / 24) + " d ago", hours: h };
}
function renderTeam() {
  const T = DATA.team, start = rangeStart();
  const tm = $("#tmetric"); tm.replaceChildren();
  for (const [k, label] of TMETRICS) {
    const b = h("button", { "aria-pressed": String(ST.tmetric === k) }, label);
    b.onclick = () => { ST.tmetric = k; save(); renderTeam(); };
    tm.append(b);
  }
  const rows = T.devices.map(dv => {
    const c = { req: 0, cw: 0, cr: 0, out: 0, in: 0 };
    for (const x of dv.days) if (!start || x.d >= start) for (const f in c) c[f] += x[f] || 0;
    c.fresh = c.cw + c.out + c.in;
    return { dv, c };
  }).sort((a, b) => b.c[ST.tmetric] - a.c[ST.tmetric]);
  const total = rows.reduce((s, r) => s + r.c[ST.tmetric], 0) || 1;
  const sum = f => rows.reduce((s, r) => s + r.c[f], 0);
  $("#teamHint").textContent = T.dir
    ? "Devices that share " + T.dir + ". This device is live; the others update whenever they export. Ranked by " + TMETRICS.find(x => x[0] === ST.tmetric)[1].toLowerCase() + " in the selected date range."
    : "Only this device is shown. To add the other people on your account, run on each device: token-report --export <shared folder> --name <who>, then restart this window.";
  const t = h("table", null, h("thead", null, h("tr", null, h("th", null, "Device"), h("th", null, "Last update"),
    ...["Requests", "New context", "Output", "Re-read"].map(x => h("th", { class: "num" }, x)), h("th", null, "Share"))), h("tbody"));
  for (const { dv, c } of rows) {
    let upd;
    if (dv.local) upd = statusCell("good", "live");
    else { const a = ago(dv.exported); upd = a.hours > 36 ? statusCell("warn", a.text + " (stale)") : h("span", null, a.text); }
    const pct = c[ST.tmetric] / total * 100;
    t.tBodies[0].append(h("tr", null, h("td", null, dv.device + (dv.local ? " (this device)" : "")), h("td", null, upd),
      ...[c.req, c.cw, c.out, c.cr].map(n => h("td", { class: "num" }, comma(n))),
      h("td", null, h("div", { class: "share" }, h("div", { class: "t" }, h("div", { class: "bar", style: "width:" + Math.max(0, pct).toFixed(1) + "%" })), h("div", { class: "pct" }, Math.round(pct) + "%")))));
  }
  t.tBodies[0].append(h("tr", { class: "total" }, h("td", null, "Total"), h("td", null, ""),
    ...[sum("req"), sum("cw"), sum("out"), sum("cr")].map(n => h("td", { class: "num" }, comma(n))), h("td", null, "")));
  $("#team").replaceChildren(t);
}

/* ---------- sessions ---------- */
function renderSessions() {
  const start = rangeStart();
  const ss = DATA.sessions.filter(s => {
    const end = s.endDate; return (!start || end >= start) && (ST.project === "all" || s.p === ST.project);
  }).sort((a, b) => b.cr - a.cr).slice(0, 10);
  const el = $("#sessions"); el.replaceChildren();
  if (!ss.length) { el.append(h("div", { class: "empty" }, "No sessions in this range.")); return; }
  const t = h("table", null, h("thead", null, h("tr", null, h("th", null, "Ended"), h("th", null, "Project"),
    ...["Requests", "Re-read", "New context", "Output"].map(x => h("th", { class: "num" }, x)), h("th", null, "Note"))), h("tbody"));
  for (const s of ss) {
    t.tBodies[0].append(h("tr", null, h("td", null, s.endDate), h("td", null, s.p + (s.sub ? " (subagent)" : "")),
      h("td", { class: "num" }, comma(s.req)), h("td", { class: "num" }, compact(s.cr)), h("td", { class: "num" }, compact(s.cw)), h("td", { class: "num" }, compact(s.out)),
      h("td", null, s.req >= 60 ? statusCell("warn", "Long: /clear would help") : "")));
  }
  el.append(t);
}

/* ---------- main ---------- */
function render() {
  if (!DATA) return;
  buildFilters();
  const A = slice();
  renderTop(A); renderTeam(); renderChart(A); renderBars(A); renderUsage(A); renderSessions();
}
function applyTheme() {
  const r = document.documentElement;
  if (ST.theme === "auto") r.removeAttribute("data-theme"); else r.setAttribute("data-theme", ST.theme);
  $("#theme").textContent = "Theme: " + ST.theme;
}
async function load(manual) {
  const main = $("#main");
  if (manual) main.classList.add("loading");
  try {
    const res = await fetch("/api/data", { cache: "no-store" });
    const d = await res.json();
    if (d.error) throw new Error(d.error);
    for (const s of d.sessions) {                     // local end date of each session
      const dt = new Date(s.end); s.endDate = isNaN(dt) ? s.end.slice(0, 10) : iso(dt);
    }
    DATA = d;
    $("#updated").textContent = "device " + DATA.team.device + " · updated " + new Date().toLocaleTimeString();
    render();
  } catch (e) {
    $("#updated").textContent = "could not load data: " + e.message;
  } finally { main.classList.remove("loading"); }
}
$("#refresh").onclick = () => load(true);
$("#tview").onclick = () => { ST.table = !ST.table; save(); render(); };
$("#project").onchange = e => { ST.project = e.target.value; save(); render(); };
$("#theme").onclick = () => { ST.theme = { auto: "light", light: "dark", dark: "auto" }[ST.theme] || "auto"; save(); applyTheme(); };
let rz; window.addEventListener("resize", () => { clearTimeout(rz); rz = setTimeout(() => DATA && renderChart(slice()), 120); });
setInterval(() => { if (!document.hidden) load(false); }, 15000);
applyTheme(); load(false);
</script>
</body>
</html>
"""

if __name__ == "__main__":
    main()
